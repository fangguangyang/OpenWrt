#!/bin/sh
. /lib/functions.sh
changed=0

configure_ap() {
    local device band hwmode mode initialized
    config_get mode "$1" mode
    [ "$mode" = ap ] || return 0
    config_get initialized "$1" m28c_initialized
    [ "$initialized" = 1 ] && return 0
    config_get device "$1" device
    config_get band "$device" band
    config_get hwmode "$device" hwmode
    case "$band:$hwmode" in
        5g:*|*:11a) uci set "wireless.$1.ssid=Widora_5G" ;;
        *) uci set "wireless.$1.ssid=Widora_2.4G" ;;
    esac
    uci set "wireless.$device.disabled=0"
    uci set "wireless.$1.disabled=0"
    uci set "wireless.$1.encryption=psk2"
    uci set "wireless.$1.key=password123"
    uci set "wireless.$1.m28c_initialized=1"
    changed=1
}

config_load wireless
config_foreach configure_ap wifi-iface
uci commit wireless
if [ "$changed" = 1 ] && [ "$1" = --reload ]; then
    ubus call network.wireless reload >/dev/null 2>&1 || true
fi
