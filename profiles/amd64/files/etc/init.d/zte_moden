#!/bin/sh

[ "$1" = update_zte_date ] || exit 0

password_file=/root/.zte-modem-password
[ -s "$password_file" ] || exit 0
IFS= read -r password < "$password_file"
[ -n "$password" ] || exit 0

utc_time=$(date -u '+%Y-%m-%d %H:%M:%S')
{
    sleep 1
    printf '%s\n' root "$password"
    sleep 1
    printf "date -u -s '%s'\n" "$utc_time"
    sleep 1
    printf 'exit\n'
} | timeout 15 telnet 192.168.1.1
